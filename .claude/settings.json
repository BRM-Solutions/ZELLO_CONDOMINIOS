{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5-5",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.key)",
      "Read(.secrets/**)",
      "Edit(.secrets/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(supabase db reset)",
      "Bash(supabase db reset *)",
      "Bash(supabase db push)",
      "Bash(supabase db push *)",
      "Bash(npx supabase db push *)",
      "Bash(pnpm supabase db push *)",
      "Bash(pnpm dlx supabase db push *)",
      "Bash(npx supabase db reset *)",
      "Bash(pnpm supabase db reset *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(supabase link *)",
      "Bash(npx supabase link *)",
      "Bash(psql *)",
      "Bash(curl *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)"
    ],
    "allow": [
      "Bash(pnpm type-check)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm --filter * type-check)",
      "Bash(pnpm --filter * lint)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter * build)",
      "Bash(pnpm --filter * exec vitest run *)",
      "Bash(supabase migration new *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)"
    ]
  }
}
