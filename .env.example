# Somente NOMES. Copie para .env (nunca commitado) e preencha localmente.
# Variaveis comentadas (#NOME=) sao opcionais. Valide com: pnpm check-env

# ---- API (apps/api) ----
NODE_ENV=development
API_PORT=3000
# Origens permitidas no CORS, separadas por virgula (URL do front)
WEB_ORIGIN=
# Supabase > Connect > Transaction pooler, usuario do papel app_api (nao o postgres)
DATABASE_URL=
# Supabase > Project Settings > API > Project URL
SUPABASE_URL=
# Padrao: SUPABASE_URL/auth/v1/.well-known/jwks.json
#SUPABASE_JWKS_URL=
# Supabase > Project Settings > API Keys > publishable (sb_publishable_...). A API a usa no Storage junto do JWT do usuario
SUPABASE_PUBLISHABLE_KEY=
# Arquivos (docs/12-storage-e-governanca.md). Bucket privado criado pela migration
#STORAGE_BUCKET=private-files
# TTL da URL assinada de download, em segundos (60-300)
#STORAGE_SIGNED_URL_TTL_SECONDS=120
# Tamanho maximo por arquivo em bytes (<= file_size_limit do bucket; padrao 10485760)
#FILE_MAX_BYTES=10485760
# MIME types aceitos, separados por virgula (padrao: pdf, jpeg, png, webp, txt, csv, docx, xlsx)
#FILE_ALLOWED_MIME=
# debug | info | warn | error
LOG_LEVEL=info

# ---- Worker (apps/api, entrypoint worker.ts; DATABASE_URL com o papel app_worker) ----
# Worker tambem precisa de SUPABASE_URL (acima) e da secret key abaixo. A secret NUNCA vai para a API nem para o web
SUPABASE_SECRET_KEY=
# Intervalo da purga/reconciliacao de arquivos (ms, minimo 10000)
#FILES_PURGE_INTERVAL_MS=600000
#WORKER_POLL_INTERVAL_MS=
#WORKER_BATCH_SIZE=

# ---- Testes (apps/api): nunca apontar para prod ----
# Conexao do projeto DEV usada por testes de integracao e refs permitidos (lista separada por virgula)
#TEST_DATABASE_URL=
#TEST_ALLOWED_DB_REFS=
# Conexao administrativa de fixture (fora do codigo da aplicacao), usada p/ criar/apagar tenants test_%
#TEST_ADMIN_DATABASE_URL=

# ---- Criptografia de campos pessoais: so quando o primeiro campo cifrado entrar (ver docs/03-seguranca.md) ----
#DATA_ENCRYPTION_KEY=
#DATA_HASH_KEY=

# ---- Web (apps/web, injetadas no build como build args) ----
VITE_API_URL=
VITE_SUPABASE_URL=
# Supabase > Project Settings > API Keys > chave publishable (sb_publishable_...); nunca a secret/service_role
VITE_SUPABASE_ANON_KEY=

# ---- CI/CD: NAO sao variaveis de app nem de .env local ----
# Cadastre em GitHub > Settings > Secrets and variables > Actions (por Environment dev/prod). Nomes:
#   Secrets: SUPABASE_ACCESS_TOKEN, SUPABASE_DB_PASSWORD_DEV|PROD, SUPABASE_PROJECT_REF_DEV|PROD
#   Secrets (Deployment Trigger URL do Easypanel, vazio = servico ainda nao criado):
#     EASYPANEL_DEPLOY_URL_API_DEV|PROD, EASYPANEL_DEPLOY_URL_WEB_DEV|PROD, EASYPANEL_DEPLOY_URL_WORKER_DEV|PROD (opcional)
#   Variables (smoke test): SMOKE_API_URL_DEV|PROD, SMOKE_WEB_URL_DEV|PROD
# Fluxo e detalhes: docs/09-deploy-easypanel-supabase.md. Dev: automatico apos o CI verde na main.
# Prod: manual (workflow_dispatch com confirm=prod), exige CI verde e deploy/dev no mesmo commit.
